# ─── Deployment ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon / Supabase / Railway / RDS).
# Leave blank to use local SQLite instead.
DATABASE_URL=

# Set to 0 to disable the in-process background worker.
KLAXON_WORKER=1

# Frontend: the deployed backend URL — set this in Vercel / Amplify env vars.
# Locally this is handled by Vite's dev proxy; no need to set it here.
VITE_API_BASE=https://your-backend-url.com/api

# ─── AI (optional) ─────────────────────────────────────────────────────────────
# Set ONE of these to enable the optional "explain this stack trace" feature.

GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# The email of the account allowed to read the public feedback inbox
# (bug reports submitted from the marketing site). Unset means nobody can —
# not even account id 1 — since on an instance with any signup history
# already on it, the earliest account is not reliably the real operator.
KLAXON_OWNER_EMAIL=

# Optional. A Slack or Discord incoming webhook URL (or any endpoint that
# accepts a JSON POST) — every new feedback submission is also pushed here,
# on top of always being saved to the inbox regardless of whether this is
# set. Delivery is durable and retried; see core/notify.py.
FEEDBACK_WEBHOOK_URL=

# Billing (Stripe). Leave all four unset to run without billing — every
# endpoint under /api/billing then returns 503 instead of a raw SDK error,
# and the rest of the app is unaffected. sk_test_/pk_test_ keys are safe to
# use freely: Stripe refuses real card numbers against them regardless of
# what the code does. See DEPLOY.md for how to get each of these.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` for local dev; from the Stripe dashboard
# (Developers → Webhooks → Add endpoint) once deployed.
STRIPE_WEBHOOK_SECRET=
# The Price id for the Pro plan — create a Product + Price in the Stripe
# dashboard, or via the API, and paste its price_... id here.
STRIPE_PRO_PRICE_ID=
